[Unit]
Description=Hermes Bot (perintah & tombol Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=PATH=__DIR__/venv/bin:/usr/bin:/bin
ExecStart=__DIR__/venv/bin/python -m hermes.bot.poller
Restart=always
RestartSec=10
StandardOutput=append:__DIR__/logs/bot.log
ErrorOutput=append:__DIR__/logs/bot_error.log

[Install]
WantedBy=multi-user.target
